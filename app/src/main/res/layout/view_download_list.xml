<?xml version="1.0" encoding="utf-8"?>
<!-- The download records list, used by the Library's Downloads tab and by a playlist's downloads -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/download_bulk_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical|end"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp"
        android:paddingBottom="2dp"
        android:visibility="gone">

        <Button
            android:id="@+id/download_pause_all"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/download_pause_all" />

        <Button
            android:id="@+id/download_resume_all"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/download_resume_all" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/download_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:paddingHorizontal="8dp"
            android:paddingVertical="6dp" />

        <TextView
            android:id="@+id/download_empty"
            style="@style/Widget.TestTube.EmptyState"
            android:drawableTop="@drawable/ic_download"
            android:text="@string/no_download_records" />
    </FrameLayout>

</LinearLayout>
