<?xml version="1.0" encoding="utf-8"?>
<!--
    Library: Queue, History and Downloads as browser-style tabs across the top. The bin at the
    end of the tab row clears whichever tab is open.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:gravity="bottom"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingTop="8dp"
        android:paddingEnd="4dp">

        <TextView
            android:id="@+id/library_tab_queue"
            style="@style/Widget.TestTube.LibraryTab"
            android:drawableStart="@drawable/ic_queue"
            android:text="@string/queue" />

        <TextView
            android:id="@+id/library_tab_history"
            style="@style/Widget.TestTube.LibraryTab"
            android:drawableStart="@drawable/ic_history"
            android:text="@string/library_history" />

        <TextView
            android:id="@+id/library_tab_downloads"
            style="@style/Widget.TestTube.LibraryTab"
            android:drawableStart="@drawable/ic_download"
            android:text="@string/library_downloads" />

        <TextView
            android:id="@+id/library_tab_stats"
            style="@style/Widget.TestTube.LibraryTab"
            android:drawableStart="@drawable/ic_segment"
            android:text="@string/library_stats" />

        <ImageButton
            android:id="@+id/library_clear"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/clear_queue"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_delete"
            app:tint="?attr/colorOnSurfaceVariant" />
    </LinearLayout>

    <!-- The selected tab has the pages' colour, so the two read as one piece -->
    <FrameLayout
        android:id="@+id/library_pages"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="?attr/ttLibraryPage">

        <LinearLayout
            android:id="@+id/library_page_queue"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical|end"
                android:orientation="horizontal"
                android:paddingHorizontal="8dp">

                <Button
                    android:id="@+id/panel_queue_save"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/queue_save" />

                <Button
                    android:id="@+id/panel_queue_load"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/queue_load" />
            </LinearLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/panel_queue_list"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:overScrollMode="never"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="6dp" />

                <TextView
                    android:id="@+id/panel_queue_empty"
                    style="@style/Widget.TestTube.EmptyState"
                    android:drawableTop="@drawable/ic_queue"
                    android:text="@string/no_queue_items" />
            </FrameLayout>
        </LinearLayout>

        <FrameLayout
            android:id="@+id/library_page_history"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/history_list"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingHorizontal="8dp"
                android:paddingBottom="6dp" />

            <TextView
                android:id="@+id/history_empty"
                style="@style/Widget.TestTube.EmptyState"
                android:drawableTop="@drawable/ic_history"
                android:text="@string/watch_history_empty" />
        </FrameLayout>

        <include
            android:id="@+id/library_page_downloads"
            layout="@layout/view_download_list"
            android:visibility="gone" />

        <ScrollView
            android:id="@+id/library_page_stats"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:padding="16dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/stats_summary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingMultiplier="1.4"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/stats_top_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/stats_top_channels"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/stats_top"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingMultiplier="1.4"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="14sp" />
            </LinearLayout>
        </ScrollView>
    </FrameLayout>
</LinearLayout>
