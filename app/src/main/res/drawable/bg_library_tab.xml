<?xml version="1.0" encoding="utf-8"?>
<!--
    Browser-style tab: the selected tab has the Library pages' colour and rounded top corners, so
    it joins the page below. Its top edge is lit along the same rounded shape: the edge colour
    fills the whole tab and the page colour sits on it 3dp lower with the same corners, leaving a
    band that runs across the top and follows both corners down.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android"
    android:enterFadeDuration="150"
    android:exitFadeDuration="150">
    <item android:state_selected="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="?attr/colorPrimary" />
                    <corners
                        android:topLeftRadius="12dp"
                        android:topRightRadius="12dp" />
                </shape>
            </item>
            <item android:top="3dp">
                <shape android:shape="rectangle">
                    <solid android:color="?attr/ttLibraryPage" />
                    <corners
                        android:topLeftRadius="12dp"
                        android:topRightRadius="12dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
</selector>
